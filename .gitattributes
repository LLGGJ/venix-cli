# Código e automação principal
*.go linguist-detectable=true
Makefile linguist-detectable=true

# Documentação e configuração não entram no gráfico de linguagens
*.md linguist-documentation=true
*.yml linguist-generated=true
*.yaml linguist-generated=true
*.json linguist-generated=true
*.toml linguist-generated=true
*.ini linguist-generated=true
*.env linguist-generated=true
*.ignore linguist-generated=true

# Scripts auxiliares não fazem parte do produto
*.py linguist-generated=true
npm-package/*.js linguist-generated=true
npm-package/*.json linguist-generated=true
